# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase Configuration (for push notifications)
# Get these from Firebase Console: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# Stripe Configuration (for payments)
# Get these from Stripe Dashboard: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Note: STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are configured in Supabase secrets

# Stripe Product Price IDs
VITE_STRIPE_PRICE_PLUS=price_...
VITE_STRIPE_PRICE_PRO=price_...

# Optional: App Configuration
# VITE_APP_URL=http://localhost:5173
# VITE_API_URL=http://localhost:5173/api
