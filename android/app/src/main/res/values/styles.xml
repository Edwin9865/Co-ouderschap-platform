<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (meestal niet gebruikt door Capacitor, maar laten staan) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Jouw app theme (WebView) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Edge-to-edge: transparante navigatiebalk -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- Launch / Splash theme -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">

        <!-- Android 12+ native splash -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>

        <!-- Fallback voor oudere Android (jij had deze al) -->
        <item name="android:background">@drawable/splash</item>

        <!-- Na splash: ga door naar jouw echte app theme -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
